DATABASE_URL=sqlite:///./dashboard.db

# Strava API v3 credentials (https://www.strava.com/settings/api)
# Required only for `python -m app.services.strava_sync` / a live sync call.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Google Calendar API (https://console.cloud.google.com - create a project,
# enable the Calendar API, create an OAuth client). Needed for /api/calendar/week.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Garmin Connect (unofficial API, your own account/password - not an official
# Garmin developer key). After setting these, run
# `python -m app.services.garmin_login` yourself, interactively, once.
GARMIN_EMAIL=
GARMIN_PASSWORD=
